# Copy to .env for local dev. In production these are set in
# Netlify → Site configuration → Environment variables.

# ── Cloudflare Turnstile (spam protection on the service request form) ────────
# Get both keys free at https://dash.cloudflare.com → Turnstile → Add site
# Widget mode: "Managed". Domains: clearmedimaging.com, www.clearmedimaging.com
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Existing integrations ─────────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
RESEND_API_KEY=
